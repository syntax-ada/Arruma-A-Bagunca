# ==========================================================================
# MODELO de variáveis de ambiente — ESTE ARQUIVO FICA SEMPRE EM BRANCO.
# ==========================================================================
# Ele é versionado no git (vai para o GitHub). NUNCA escreva valores reais
# aqui: nem chave, nem senha, nem PIN. Ele só mostra QUAIS variáveis existem.
#
# Onde colocar os valores reais:
#   - No seu computador: copie este arquivo para ".env.local" (o git ignora
#     esse arquivo) e preencha lá. Depois rode:
#       node --env-file=.env.local scripts/servidor-local.js
#   - Na Vercel: Settings → Environment Variables (Preview e Production).
#
# Antes de qualquer commit, confira: "git diff .env.example" deve mostrar
# apenas nomes de variáveis, sem nada depois do "=".

# --- Servidor local (opcionais) -------------------------------------------
PORTA=3000
HOST=127.0.0.1

# --- Supabase (obrigatórias para a identificação do jogador) ---------------
# Usadas por api/_lib/supabase.js (tabela public.players). Sem elas, o
# servidor responde "Não conseguimos conectar agora".
#
# SUPABASE_URL: endereço https do projeto, sem barra no final.
SUPABASE_URL=
# SUPABASE_SECRET_KEY: use a chave SECRETA (começa com "sb_secret_"), nunca a
# publicável ("sb_publishable_"): o servidor recusa a publicável. Ela fica só
# no servidor — nunca no navegador, no frontend ou neste arquivo.
SUPABASE_SECRET_KEY=

# --- Progresso do jogador (salvar fases concluídas no Supabase) -----------
# Usada por api/jogadores e api/progresso/*: assina a sessão do jogador. O
# banco precisa ter as tabelas phase_completions e player_sessions (migrações
# em supabase/migrations/, aplicadas pela equipe — veja
# docs/progresso-supabase.md e docs/seguranca.md).
# Sem ela, o jogo funciona, mas o progresso fica só no navegador.
#
# PLAYER_SESSION_SECRET: texto aleatório com pelo menos 32 caracteres e
# DIFERENTE do ADMIN_SESSION_SECRET. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor obriga os jogadores a digitar o apelido de novo (o
# progresso não se perde).
PLAYER_SESSION_SECRET=

# --- Acesso administrativo (login em admin.html e painel DEV publicado) ---
# Usadas por api/admin/*. Sem elas, o login responde "indisponível" e o
# painel DEV não abre no site publicado (em localhost, ?dev=true continua
# funcionando sem elas).
#
# ADMIN_PIN_HASH: hash do PIN (NUNCA o PIN). Gere com:
#   node scripts/gerar-hash-pin.js
ADMIN_PIN_HASH=
# ADMIN_SESSION_SECRET: texto aleatório com pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor encerra todas as sessões administrativas.
ADMIN_SESSION_SECRET=
# ADMIN_ALLOWED_ORIGINS: endereços de onde o login é aceito, separados por
# vírgula, sem barra no final. Ex.: https://seu-jogo.vercel.app ou, no
# servidor local, http://localhost:3000
ADMIN_ALLOWED_ORIGINS=
