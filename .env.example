# Modelo de variáveis de ambiente. NÃO coloque valores reais neste arquivo.
# Para usar localmente: copie para .env.local (ignorado pelo git) e rode
#   node --env-file=.env.local scripts/servidor-local.js
#
# No incremento 1 nenhuma variável é obrigatória: o servidor local funciona
# sem este arquivo.

# Servidor local (opcionais)
PORTA=3000
HOST=127.0.0.1

# Supabase — etapas 3 e 4 (ainda não usado).
# A chave secreta fica SÓ no servidor; nunca vai para o navegador.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Sessão administrativa — etapa 7 (ainda não usado).
# Texto aleatório com pelo menos 32 caracteres.
ADMIN_SESSION_SECRET=
