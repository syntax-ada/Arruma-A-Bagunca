# ==========================================================================
# MODELO de variáveis de ambiente — ESTE ARQUIVO FICA SEMPRE EM BRANCO.
# ==========================================================================
# Ele é versionado no git (vai para o GitHub). NUNCA escreva valores reais
# aqui: nem chave, nem senha, nem PIN. Ele só mostra QUAIS variáveis existem.
#
# Onde colocar os valores reais:
#   - No seu computador: copie este arquivo para ".env.local" (o git ignora
#     esse arquivo) e preencha lá. Depois rode:
#       node --env-file=.env.local scripts/servidor-local.js
#   - Na Vercel: Settings → Environment Variables (Preview e Production).
#
# Antes de qualquer commit, confira: "git diff .env.example" deve mostrar
# apenas nomes de variáveis, sem nada depois do "=".

# --- Servidor local (opcionais) -------------------------------------------
PORTA=3000
HOST=127.0.0.1

# --- Supabase (obrigatórias para a identificação do jogador) ---------------
# Usadas por api/_lib/supabase.js (tabela public.players). Sem elas, o
# servidor responde "Não conseguimos conectar agora".
#
# SUPABASE_URL: endereço https do projeto, sem barra no final.
SUPABASE_URL=
# SUPABASE_SECRET_KEY: use a chave SECRETA (começa com "sb_secret_"), nunca a
# publicável ("sb_publishable_"): o servidor recusa a publicável. Ela fica só
# no servidor — nunca no navegador, no frontend ou neste arquivo.
SUPABASE_SECRET_KEY=

# --- Sessão administrativa (etapa 7 — ainda não usado) --------------------
# Texto aleatório com pelo menos 32 caracteres.
ADMIN_SESSION_SECRET=
